<Window x:Class="MeuAssistente.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MeuAssistente.App.Views"
        Title="Meu Assistente" Height="780" Width="1240"
        MinHeight="660" MinWidth="960" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid>
    <views:AuthView DataContext="{Binding Autenticacao}">
      <views:AuthView.Style><Style TargetType="views:AuthView"><Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers><DataTrigger Binding="{Binding DataContext.Autenticado, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
      </Style></views:AuthView.Style>
    </views:AuthView>
    <views:WorkspaceView DataContext="{Binding AreaTrabalho}">
      <views:WorkspaceView.Style><Style TargetType="views:WorkspaceView"><Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers><DataTrigger Binding="{Binding DataContext.Autenticado, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
      </Style></views:WorkspaceView.Style>
    </views:WorkspaceView>
  </Grid>
</Window>
