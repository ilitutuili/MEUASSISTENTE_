<UserControl x:Class="MeuAssistente.App.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContextChanged="AuthView_OnDataContextChanged">
  <Grid Background="#111827">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
    <Grid Grid.Column="0" ClipToBounds="True">
      <Border Background="#101A2B" />
      <Ellipse Width="420" Height="420" Fill="#183C4C" Opacity="0.58"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-210,-150,0" />
      <Ellipse Width="330" Height="330" Fill="#13283E" Opacity="0.8"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-150,0,0,-150" />
      <StackPanel VerticalAlignment="Center" Margin="58">
      <Border Width="54" Height="54" Background="#10A37F" CornerRadius="16" HorizontalAlignment="Left">
        <TextBlock Text="MA" Foreground="White" FontWeight="Bold" FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="MEU ASSISTENTE" Foreground="#A8B8C9" FontWeight="Bold" FontSize="12" Margin="0,22,0,24" />
      <TextBlock Text="Sua rotina,&#10;mais organizada." Foreground="White" FontSize="40" FontWeight="Bold" />
      <Border Width="58" Height="4" Background="#10A37F" CornerRadius="2"
              HorizontalAlignment="Left" Margin="0,22,0,0" />
      <TextBlock Text="Reúna tarefas, compromissos e anotações em um só lugar."
                 Foreground="#D5DFEA" FontSize="16" TextWrapping="Wrap" Margin="0,18,20,0" Opacity="0.9" />
      <Border Margin="0,34,0,0" Padding="14,12" CornerRadius="12" Background="#1C2B3B" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="✓" Foreground="#4DD4A5" FontSize="17" FontWeight="Bold" Margin="0,0,10,0" />
          <TextBlock Text="Seus dados ficam neste computador" Foreground="#D5DFEA" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <TextBlock Text="O banco do aplicativo fica neste computador. O envio de dados por voz e pelo chat será informado nas respectivas configurações."
                 Foreground="#A8B8C9" FontSize="11" TextWrapping="Wrap" Margin="0,22,20,0" Opacity="0.8" />
      </StackPanel>
    </Grid>
    <Border Grid.Column="1" Margin="28" Padding="36" CornerRadius="20"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Bem-vindo" FontSize="28" FontWeight="Bold" />
          <TextBlock Text="Entre na sua conta ou crie uma nova para começar."
                     Margin="0,6,0,24" Opacity="0.7" TextWrapping="Wrap" />
          <StackPanel Margin="0,8,0,0">
            <StackPanel.Style>
              <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding ModoCadastro}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Nome" Margin="0,8,0,5" />
            <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Height="38" />
          </StackPanel>
          <TextBlock Text="E-mail" Margin="0,12,0,5" />
          <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="38" />
          <TextBlock Text="Senha" Margin="0,14,0,5" />
          <PasswordBox x:Name="SenhaInput" Height="38" PasswordChanged="SenhaInput_OnPasswordChanged" />
          <StackPanel Margin="0,8,0,0">
            <StackPanel.Style>
              <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding ModoCadastro}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Confirme a senha" Margin="0,14,0,5" />
            <PasswordBox x:Name="ConfirmacaoInput" Height="38" PasswordChanged="ConfirmacaoInput_OnPasswordChanged" />
          </StackPanel>
          <CheckBox Content="Manter sessão iniciada neste computador" IsChecked="{Binding ManterSessao}" Margin="0,16,0,0">
            <CheckBox.Style><Style TargetType="CheckBox"><Setter Property="Visibility" Value="Visible" />
              <Style.Triggers><DataTrigger Binding="{Binding ModoCadastro}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style></CheckBox.Style>
          </CheckBox>
          <Button Content="Entrar" Command="{Binding EntrarCommand}" Height="42" Margin="0,20,0,0">
            <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible" />
              <Style.Triggers><DataTrigger Binding="{Binding ModoCadastro}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style></Button.Style>
          </Button>
          <Button Content="Criar conta" Command="{Binding CadastrarCommand}" Height="42" Margin="0,20,0,0">
            <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers><DataTrigger Binding="{Binding ModoCadastro}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style></Button.Style>
          </Button>
          <Button Content="Criar conta" Command="{Binding MostrarCadastroCommand}" Margin="0,8,0,0">
            <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible" />
              <Style.Triggers><DataTrigger Binding="{Binding ModoCadastro}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style></Button.Style>
          </Button>
          <Button Content="Voltar ao login" Command="{Binding MostrarLoginCommand}" Margin="0,8,0,0">
            <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers><DataTrigger Binding="{Binding ModoCadastro}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style></Button.Style>
          </Button>
          <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,18,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
