<UserControl x:Class="MeuAssistente.App.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MeuAssistente.App.Views">
  <UserControl.Resources>
    <local:DateOnlyParaExibicao x:Key="ConversorData" />
    <local:TimeOnlyParaExibicao x:Key="ConversorHorario" />
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Margin="16,14,16,0" Padding="16,11" CornerRadius="14"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="#263849" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" Background="#10A37F" CornerRadius="10" Margin="0,0,11,0">
            <TextBlock Text="MA" Foreground="White" FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="MEU ASSISTENTE" FontWeight="Bold" FontSize="12" />
            <TextBlock Text="Organize seu dia" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="2" Margin="12,0" Padding="12,6" CornerRadius="10"
                Background="#122B2A" VerticalAlignment="Center" MaxWidth="260">
          <TextBlock Text="{Binding NomeUsuario}" Foreground="#AEE8D5" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </Border>
        <Button Grid.Column="3" Content="Sair da conta" Command="{Binding SairDaContaCommand}"
                VerticalAlignment="Center" Padding="14,6" />
      </Grid>
    </Border>
    <StackPanel DockPanel.Dock="Bottom" Margin="18,6,18,10">
      <TextBlock Text="{Binding Erro}" Foreground="#D64545" TextWrapping="Wrap" />
    </StackPanel>
    <TabControl Margin="18" SelectedIndex="{Binding IndiceAbaSelecionada}">
      <TabItem Header="Assistente local">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ListBox Grid.Row="0" ItemsSource="{Binding MensagensAssistente}" BorderThickness="0"
                   Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="12" Margin="0,4" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                  <StackPanel>
                    <TextBlock Text="{Binding Rotulo}" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="1" Padding="12" Margin="0,10" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers><DataTrigger Binding="{Binding TemProposta}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style></Border.Style>
            <StackPanel>
              <TextBlock Text="Confirmar ação" FontWeight="Bold" />
              <TextBlock Text="{Binding TextoProposta}" TextWrapping="Wrap" Margin="0,5,0,8" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Command="{Binding CancelarComandoLocalCommand}" Margin="0,0,8,0" Padding="14,6" />
                <Button Content="Confirmar" Command="{Binding ConfirmarComandoLocalCommand}" Padding="14,6" />
              </StackPanel>
            </StackPanel>
          </Border>
          <DockPanel Grid.Row="2">
            <Button Content="Enviar" Command="{Binding EnviarComandoLocalCommand}" DockPanel.Dock="Right"
                    Margin="8,0,0,0" Padding="16,8" />
            <TextBox Text="{Binding PerguntaAssistente, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="40" VerticalContentAlignment="Center" AcceptsReturn="True"
                     TextWrapping="Wrap" ToolTip="Ex.: criar tarefa Revisar relatório" />
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Chat com IA" DataContext="{Binding Chat}">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Converse com o provedor configurado" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="As mensagens deste chat podem ser processadas pelo serviço externo selecionado. Dados locais não são enviados automaticamente."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding ProvedorAtual}" Margin="0,4,0,0" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Mensagens}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate><DataTemplate>
              <Border Padding="12" Margin="0,4" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                  <TextBlock Text="{Binding Rotulo}" FontWeight="Bold" Margin="0,0,0,4" />
                  <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="{Binding Erro}" Foreground="#D64545" TextWrapping="Wrap" Margin="0,4" />
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Pergunta, UpdateSourceTrigger=PropertyChanged}" MinHeight="42" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalContentAlignment="Center" ToolTip="Escreva sua mensagem" />
            <Button Grid.Column="1" Content="Enviar" Command="{Binding EnviarCommand}" Margin="8,0,0,0" Padding="14,6">
              <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible" />
                <Style.Triggers><DataTrigger Binding="{Binding Ocupado}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
              </Style></Button.Style>
            </Button>
            <Button Grid.Column="1" Content="Parar" Command="{Binding PararCommand}" Margin="8,0,0,0" Padding="14,6">
              <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding Ocupado}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style></Button.Style>
            </Button>
            <Button Grid.Column="2" Content="Falar" Command="{Binding CapturarVozCommand}" Margin="8,0,0,0" Padding="14,6" />
            <CheckBox Grid.Column="3" Content="Ler respostas" IsChecked="{Binding LerRespostasEmVoz}" VerticalAlignment="Center" Margin="10,0,0,0" />
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Tarefas">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox Width="310" Height="36" VerticalContentAlignment="Center" ToolTip="Tarefa"
                     Text="{Binding TituloTarefa, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="130" Margin="8,0" ItemsSource="{Binding Prioridades}"
                      SelectedItem="{Binding PrioridadeTarefa}" />
            <Button Content="Adicionar tarefa" Command="{Binding SalvarTarefaCommand}" Padding="14,6">
              <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible" />
                <Style.Triggers><DataTrigger Binding="{Binding EditandoTarefa}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
              </Style></Button.Style>
            </Button>
            <Button Content="Salvar alterações" Command="{Binding SalvarTarefaCommand}" Padding="14,6">
              <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding EditandoTarefa}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style></Button.Style>
            </Button>
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Tarefas}" SelectedItem="{Binding TarefaSelecionada}"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tarefa" Binding="{Binding Titulo}" Width="*" />
              <DataGridTextColumn Header="Prioridade" Binding="{Binding Prioridade}" Width="130" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Editar selecionada" Command="{Binding PrepararEdicaoTarefaCommand}" Padding="14,6" />
            <Button Content="Concluir / reabrir" Command="{Binding AlternarConclusaoTarefaCommand}" Padding="14,6" />
            <Button Content="Excluir selecionada" Command="{Binding ExcluirTarefaCommand}" Margin="8,0,0,0" Padding="14,6" />
            <Button Content="Cancelar edição" Command="{Binding CancelarEdicaoTarefaCommand}" Margin="8,0,0,0" Padding="14,6">
              <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding EditandoTarefa}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style></Button.Style>
            </Button>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Agenda">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <GroupBox Header="Compromisso" Padding="10">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBox Grid.Column="0" Margin="3" ToolTip="Título" Text="{Binding TituloCompromisso, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Grid.Column="1" Margin="3" ToolTip="Data (DD/MM/AAAA)" Text="{Binding DataCompromisso, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Grid.Column="2" Margin="3" ToolTip="Horário (HH:mm)" Text="{Binding HorarioCompromisso, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="3" Grid.RowSpan="2" Content="Adicionar" Command="{Binding SalvarCompromissoCommand}" Margin="6,3" Padding="12,4">
                <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers><DataTrigger Binding="{Binding EditandoCompromisso}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style></Button.Style>
              </Button>
              <Button Grid.Column="3" Grid.RowSpan="2" Content="Salvar alterações" Command="{Binding SalvarCompromissoCommand}" Margin="6,3" Padding="12,4">
                <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding EditandoCompromisso}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Button.Style>
              </Button>
              <TextBox Grid.Row="1" Grid.ColumnSpan="3" Margin="3" ToolTip="Descrição (opcional)"
                       Text="{Binding DescricaoCompromisso, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
          </GroupBox>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
            <TextBlock Text="De" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox Width="120" ToolTip="DD/MM/AAAA" Text="{Binding FiltroDataInicial, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Até" VerticalAlignment="Center" Margin="10,0,5,0" />
            <TextBox Width="120" ToolTip="DD/MM/AAAA" Text="{Binding FiltroDataFinal, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Filtrar" Command="{Binding FiltrarCompromissosCommand}" Margin="8,0,0,0" Padding="12,4" />
            <Button Content="Limpar" Command="{Binding LimparFiltroCompromissosCommand}" Margin="5,0,0,0" Padding="12,4" />
          </StackPanel>
          <DataGrid Grid.Row="2" ItemsSource="{Binding Compromissos}" SelectedItem="{Binding CompromissoSelecionado}"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*" />
              <DataGridTextColumn Header="Data" Binding="{Binding Data, Converter={StaticResource ConversorData}}" Width="130" />
              <DataGridTextColumn Header="Horário" Binding="{Binding Horario, Converter={StaticResource ConversorHorario}}" Width="100" />
              <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="2*" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Editar selecionado" Command="{Binding PrepararEdicaoCompromissoCommand}" Padding="14,6" />
            <Button Content="Excluir selecionado" Command="{Binding ExcluirCompromissoCommand}"
                    Margin="8,0,0,0" Padding="14,6" />
            <Button Content="Cancelar edição" Command="{Binding CancelarEdicaoCompromissoCommand}" Margin="8,0,0,0" Padding="14,6">
              <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding EditandoCompromisso}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style></Button.Style>
            </Button>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Anotações">
        <Grid Margin="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DataGrid Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Anotacoes}" SelectedItem="{Binding AnotacaoSelecionada}"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Margin="0,0,12,0">
            <DataGrid.Columns><DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*" /></DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Criar ou editar anotação" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBox ToolTip="Título" Text="{Binding TituloAnotacao, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
            <TextBox ToolTip="Texto" Height="105" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Text="{Binding TextoAnotacao, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,18">
              <Button Content="Salvar anotação" Command="{Binding SalvarAnotacaoCommand}" Padding="12,6">
                <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers><DataTrigger Binding="{Binding EditandoAnotacao}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style></Button.Style>
              </Button>
              <Button Content="Salvar alterações" Command="{Binding SalvarAnotacaoCommand}" Padding="12,6">
                <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding EditandoAnotacao}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Button.Style>
              </Button>
            </StackPanel>
            <TextBlock Text="Anotação selecionada" FontWeight="Bold" />
            <TextBlock Text="{Binding AnotacaoSelecionada.Titulo}" FontSize="15" Margin="0,5,0,5" />
            <TextBox Text="{Binding AnotacaoSelecionada.Texto}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="150" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Editar selecionada" Command="{Binding PrepararEdicaoAnotacaoCommand}" Padding="14,6" />
            <Button Content="Fixar no desktop" Command="{Binding FixarAnotacaoCommand}" Padding="14,6" />
            <Button Content="Excluir selecionada" Command="{Binding ExcluirAnotacaoCommand}" Margin="8,0,0,0" Padding="14,6" />
            <Button Content="Cancelar edição" Command="{Binding CancelarEdicaoAnotacaoCommand}" Margin="8,0,0,0" Padding="14,6">
              <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding EditandoAnotacao}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style></Button.Style>
            </Button>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Configurações" DataContext="{Binding Configuracoes}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Inteligência artificial" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Escolha um serviço compatível com a API de chat. Consulte o endpoint e o identificador do modelo na documentação do provedor."
                       TextWrapping="Wrap" Margin="0,4,0,12" />
            <TextBlock Text="Provedor" />
            <ComboBox ItemsSource="{Binding Provedores}" SelectedItem="{Binding Provedor}" Margin="0,4,0,10" />
            <TextBlock Text="Endpoint" />
            <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
            <TextBlock Text="Modelo" />
            <TextBox Text="{Binding Modelo, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
            <TextBlock Text="Chave de API (vazia mantém a chave salva)" />
            <PasswordBox x:Name="EntradaChaveApi" PasswordChanged="ChaveApiPasswordChanged" Margin="0,4,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="Chave protegida salva: " />
              <TextBlock Text="{Binding TemChaveSalva}" />
            </StackPanel>
            <CheckBox Content="Remover a chave salva" IsChecked="{Binding RemoverChave}" Margin="0,0,0,8" />
            <CheckBox Content="Permitir pesquisa na web (OpenRouter)" IsChecked="{Binding PesquisaWeb}" Margin="0,0,0,8" />
            <Button Content="Salvar configuração de IA" Command="{Binding SalvarIaCommand}" Click="LimparCampoChaveApi"
                    HorizontalAlignment="Left" Padding="14,7" />

            <Separator Margin="0,20" />
            <TextBlock Text="Aparência" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Tema" Margin="0,10,0,0" />
            <ComboBox ItemsSource="{Binding Temas}" SelectedItem="{Binding Tema}" Margin="0,4,0,10" />
            <TextBlock Text="Cor de destaque (hexadecimal)" />
            <TextBox Text="{Binding CorDestaque, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
            <Button Content="Salvar aparência" Command="{Binding SalvarVisualCommand}"
                    HorizontalAlignment="Left" Padding="14,7" />
            <TextBlock Text="Dados de tarefas, agenda e anotações ficam neste computador. Chat externo envia a conversa ao provedor selecionado. Reconhecimento e síntese de voz usam os recursos locais do Windows."
                       TextWrapping="Wrap" Margin="0,20,0,8" />
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
